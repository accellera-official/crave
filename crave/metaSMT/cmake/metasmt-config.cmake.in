@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

if(@metaSMT_USE_Aiger@)
    find_dependency(aiger)
    message(STATUS "metaSMT solver: aiger")
endif()
if(@metaSMT_USE_picosat@)
    find_dependency(picosat)
    message(STATUS "metaSMT solver: picosat")
endif()
if(@metaSMT_USE_lingeling@)
    find_dependency(lingeling)
    message(STATUS "metaSMT solver: lingeling")
endif()
if(@metaSMT_USE_YICES2@)
    find_dependency(yices2)
    message(STATUS "metaSMT solver: yices2")
endif()
find_dependency(gmp)
message(STATUS "metaSMT solver: gmp")
if(@metaSMT_USE_Z3@)
    find_dependency(z3)
    message(STATUS "metaSMT solver: z3")
endif()
if(@metaSMT_USE_CUDD@)
    find_dependency(cudd)
    message(STATUS "metaSMT solver: cudd")
endif()
if(@metaSMT_USE_CVC4@)
    find_dependency(CVC4)
    message(STATUS "metaSMT solver: CVC4")
endif()
if(@metaSMT_USE_STP@)
    find_dependency(stp)
    message(STATUS "metaSMT solver: stp")
endif()
if(@metaSMT_USE_MiniSat@ OR @metaSMT_USE_STP@)
    find_dependency(minisat)
    message(STATUS "metaSMT solver: minisat")
endif()
if(@metaSMT_USE_Boolector@)
    find_dependency(boolector)
    message(STATUS "metaSMT solver: boolector")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/metasmt-targets.cmake")

set(metaSMT_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set(metaSMT_lIBRARIES metaSMT::metaSMT)
