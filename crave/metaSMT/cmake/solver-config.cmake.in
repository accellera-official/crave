@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
@SOLVER_FIND_DEPS@

if(NOT TARGET @SOLVER_TARGET@)
    add_library(@SOLVER_TARGET@ UNKNOWN IMPORTED)
    set_target_properties(@SOLVER_TARGET@ PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@SOLVER_LIBDIR@/@SOLVER_LIBNAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@SOLVER_INCLUDEDIR@"
    )
    @SOLVER_SET_LINK_LIBS@
endif()

set(@SOLVER_VARNAME@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@SOLVER_INCLUDEDIR@")
set(@SOLVER_VARNAME@_LIBRARIES @SOLVER_TARGET@)
